ENVIRONMENT=development

# From Supabase Dashboard > Project Settings > API (see supabase/README.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From Supabase Dashboard > Project Settings > API > JWT Settings ("JWT
# Secret"). Used to verify the Supabase Auth token the frontend sends on
# requests that need to know who the caller is (KAN-19's upload endpoint).
SUPABASE_JWT_SECRET=

# From console.anthropic.com — used to auto-structure uploaded syllabus files
# into a subject/topic tree (KAN-19).
ANTHROPIC_API_KEY=

# From platform.openai.com — optional. Powers the doubt-solving chat
# assistant, Q&A bank semantic search/dedup, and voice check-in
# transcription. Leave blank and the app runs fine — those three features
# just stay hidden until this is set.
OPENAI_API_KEY=

# Local path to the Firebase service account JSON downloaded from
# Firebase Console > Project Settings > Service Accounts. Never commit this
# file — it's gitignored. In Render, use a Secret File instead and point
# this at its mounted path (see docs/SETUP.md).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
