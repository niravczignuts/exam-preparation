# From Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Supabase anon key + URL (safe for the frontend, respects RLS).
# VITE_SUPABASE_URL is the bare project URL from Project Settings > API >
# Project URL, e.g. https://<project-ref>.supabase.co — NOT the "REST URL"
# shown elsewhere on that page (which ends in /rest/v1). supabase-js appends
# /auth/v1, /rest/v1, /storage/v1 etc itself; a trailing /rest/v1 here
# duplicates that path and breaks auth with "Invalid path specified in
# request URL".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API base URL (Render service URL in production; proxied via
# netlify.toml redirects in production so this can stay relative there)
VITE_API_BASE_URL=http://localhost:8000
